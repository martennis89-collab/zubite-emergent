# Zubite.bg — backend env template
# Copy to backend/.env and fill with real values. Never commit the real .env.

# ── MongoDB ────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=zubite_db

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; preview/production hosts
# already covered by hard-coded regex in code, this overrides.
CORS_ORIGINS=

# ── Auth ──────────────────────────────────────────────────────────
# JWT signing key — must be ≥ 24 chars (≥144 bits). Use a CSPRNG.
JWT_SECRET=replace-with-32+char-random-string

# ── Email (Resend) ────────────────────────────────────────────────
# Get key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=hello@zubite.bg
ADMIN_EMAIL=admin@zubite.bg

# ── Object storage: Cloudflare R2 (S3-compatible) ─────────────────
# Replaces Emergent's object store. The bucket must stay PRIVATE —
# files are only served back through GET /api/files/{id}, never from a
# public bucket URL.
#
# R2_ENDPOINT is the account endpoint WITHOUT the bucket name. The
# Cloudflare dashboard shows the "S3 API" value with the bucket appended
# (https://<account-id>.r2.cloudflarestorage.com/<bucket>) — put the
# bucket in R2_BUCKET instead. (A trailing bucket is stripped defensively,
# but keep them separate.)
# Create the keys under R2 → Manage API tokens → Object Read & Write.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=zubitebg
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── Next.js ISR revalidation ──────────────────────────────────────
# Shared secret between FastAPI and Next.js /api/revalidate route.
REVALIDATE_SECRET=replace-with-random-string
