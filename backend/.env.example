# Zubite.bg backend environment template.
# Copy to backend/.env for local development. Never commit the real file.

APP_ENV=development

# Local Docker publishes MongoDB on 27018. When the backend itself runs in
# Docker Compose, docker-compose.yml overrides this with mongodb://mongo:27017.
MONGO_URL=mongodb://127.0.0.1:27018
DB_NAME=zubite_db
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=50

# Comma-separated browser origins. The production Render Blueprint supplies
# zubite.bg and www.zubite.bg.
CORS_ORIGINS=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-24-characters

# Shared with the frontend. Generate a separate value from JWT_SECRET.
REVALIDATE_SECRET=replace-with-a-random-shared-secret

# Cloudflare R2. Keep the bucket private; the API proxies all object reads.
# Standard endpoint: https://<account-id>.r2.cloudflarestorage.com
# EU jurisdiction: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=zubite-production
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Public URLs used in links, emails, and Next.js revalidation callbacks.
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=http://localhost:3000

# This backend's own public origin. On Render set it to the
# https://<service>.onrender.com URL. Used as the `callbackUrl` sent to
# Make so the scenario knows where to POST the finished article back.
# Falls back to PRODUCTION_URL, which reaches the same route through the
# frontend's /api proxy.
BACKEND_PUBLIC_URL=http://127.0.0.1:8001

# Make.com article automation. Unset means the admin's "generate" button
# returns 503 make_not_configured and Make's callback is rejected -- the
# same unconfigured-is-valid rule the email sender follows.
# The webhook URL is the Make scenario's custom-webhook address.
MAKE_CONTENT_AUTOMATION_WEBHOOK_URL=
# One shared secret, used in both directions: sent in the body to Make, and
# compared against the `secret` field of Make's callback.
MAKE_CONTENT_AUTOMATION_SECRET=
# Optional. Sent as the `x-make-apikey` header on the outbound call.
MAKE_CONTENT_AUTOMATION_API_KEY=
# Optional override. Set only when the callback must not sit at the default
# <BACKEND_PUBLIC_URL>/api/admin/content-automation/import-from-make path.
CONTENT_AUTOMATION_CALLBACK_URL=

# Web Push (VAPID) for Общност thread-follow notifications. Optional —
# unset means push sends are skipped with a warning, nothing breaks.
# Generate with: python -m scripts.generate_vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=info@zubite.bg

# Email is optional locally and expected in production.
RESEND_API_KEY=
SENDER_EMAIL=hello@zubite.bg
# Clinic intake invitations and the approval email with first credentials.
# Everything else stays on SENDER_EMAIL. Unset falls back to SENDER_EMAIL.
CLINIC_ONBOARDING_SENDER_EMAIL=onboarding@zubite.bg
ZUBITE_ADMIN_NOTIFICATION_EMAIL=info@zubite.bg

AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax
AUTH_REQUIRE_COOKIE=0
AUDIT_LOGS_ENABLED=1

# Confirmed consultations recorded before automated booking tracking.
HOME_TRUST_CONSULTATIONS_BASELINE=12

# Clear Advance — the platform every connected clinic reports leads and
# outcomes to. Optional: unset means nothing is reported and nothing breaks.
# Each clinic's own API key is stored encrypted in Mongo, not here; the secret
# below is what encrypts them, so rotating it orphans every stored key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLEAR_ADVANCE_API_URL=
CLEAR_ADVANCE_KEY_SECRET=
# Partner key (ca_pk_...) that enrols every newly created clinic in Clear
# Advance automatically. Minted in Clear Advance with `npm run partner:key`.
# Unset means new clinics are queued and wait; nothing breaks.
CLEAR_ADVANCE_PARTNER_KEY=
