# Zubite.bg — backend env template
# Copy to backend/.env and fill with real values. Never commit the real .env.

# ── MongoDB ────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=zubite_db

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; preview/production hosts
# already covered by hard-coded regex in code, this overrides.
CORS_ORIGINS=

# ── Auth ──────────────────────────────────────────────────────────
# JWT signing key — must be ≥ 24 chars (≥144 bits). Use a CSPRNG.
JWT_SECRET=replace-with-32+char-random-string

# ── Email (Resend) ────────────────────────────────────────────────
# Get key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=hello@zubite.bg
ADMIN_EMAIL=admin@zubite.bg

# ── Emergent LLM (universal key for OpenAI/Anthropic/Gemini) ──────
EMERGENT_LLM_KEY=emergent_your_universal_key

# ── ElevenLabs (Conversational AI outbound calls) ─────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_agent_id
# Webhook signature secret used to verify post-call payloads.
ELEVENLABS_WEBHOOK_SECRET=your_webhook_signing_secret
# ElevenLabs-side phone number id linking to Twilio.
ELEVENLABS_TWILIO_PHONE_ID=your_phone_id

# ── Twilio (telephony) ────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555555555

# ── Next.js ISR revalidation ──────────────────────────────────────
# Shared secret between FastAPI and Next.js /api/revalidate route.
REVALIDATE_SECRET=replace-with-random-string
