# Zubite.bg frontend environment template.
# Copy to frontend/.env.local for a non-Docker local run.

# Keep this empty in local Docker and on Vercel. Browser requests then use the
# same-origin /api proxy, preserving first-party auth cookies.
NEXT_PUBLIC_API_URL=

# Server-only upstream used by Next.js rewrites and server components.
# Use http://127.0.0.1:8001 outside Docker, http://backend:8001 in Compose,
# and the HTTPS onrender.com service URL on Vercel.
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# Must exactly match the backend REVALIDATE_SECRET.
REVALIDATE_SECRET=replace-with-the-same-random-shared-secret

# Canonical public site URL for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
