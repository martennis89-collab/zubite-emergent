# Zubite.bg — frontend env template (committed to git)
# Copy to frontend/.env (and frontend/.env.local for local-only overrides).
# Never commit the real .env / .env.local — they are gitignored.

# Public backend URL exposed to the browser. Both names point to the same
# value — REACT_APP_BACKEND_URL is required by Emergent's ingress routing,
# NEXT_PUBLIC_API_URL is the standard Next.js convention.
REACT_APP_BACKEND_URL=https://your-backend.example.com
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Server-side only URL used by Next.js server components when the backend
# is reachable on a private hostname. Falls back to the public URL.
INTERNAL_API_URL=http://backend:8001

# Shared secret between FastAPI and Next.js /api/revalidate route.
# Must match REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=replace-with-random-string

# Public canonical site URL (used in canonicals, sitemaps, OG tags).
NEXT_PUBLIC_SITE_URL=https://zubite.bg

# Server-only internal backend URL (alias of INTERNAL_API_URL).
BACKEND_INTERNAL_URL=http://backend:8001
