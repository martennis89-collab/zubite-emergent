етейнер за запазване на резултата."}]]]}],["$","p",null,{"className":"text-sm text-slate-400 mt-6 italic","children":"Информацията е образователна и не замества преглед."}]]}]}],["$","section",null,{"className":"py-12 bg-slate-50","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6","children":[["$","h2",null,{"className":"font-serif text-2xl font-semibold text-slate-900 mb-6","children":"Кога да потърсите специалист"}],["$","div",null,{"className":"bg-white rounded-2xl border border-slate-200 p-6","children":["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"w-5 h-5 text-sky-500 flex-shrink-0 mt-0.5","children":[["$","path","g774vq",{"d":"M22 11.08V12a10 10 0 1 1-5.93-9.14"}],["$","polyline","6xbx8j",{"points":"22 4 12 14.01 9 11.01"}],"$undefined"]}],["$","span",null,{"className":"text-slate-600","children":"Криви или накривени зъби"}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"w-5 h-5 text-sky-500 flex-shrink-0 mt-0.5","children":[["$","path","g774vq",{"d":"M22 11.08V12a10 10 0 1 1-5.93-9.14"}],["$","polyline","6xbx8j",{"points":"22 4 12 14.01 9 11.01"}],"$undefined"]}],["$","span",null,{"className":"text-slate-600","children":"Препокриване на зъбите"}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoi